# CINE-AI Backend URL (Pointing to your live Railway Spring Boot service)
# Example: https://cineai-backend-production.up.railway.app
CINEAI_BASE_URL=https://<your-backend-service>.up.railway.app

# Server Port (Railway sets this automatically, default 8080)
PORT=8080

# Server Host
HOST=0.0.0.0

# Optional: Default credentials to auto-login this MCP server on startup
# If omitted, you can dynamically register or log in directly inside Claude chat!
# CINEAI_USER_EMAIL=adamgoya0810@gmail.com
# CINEAI_USER_PASSWORD=your_password
