# ==============================================================
# CineAI Environment Configuration
# ==============================================================

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cineai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- In-Memory Cache & Seat Holds (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Security / JWT ---
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# --- Email Notifications (SMTP / Mailhog / Mailtrap) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false

# --- Admin Account ---
# Set a strong password for the seeded admin accounts in production
ADMIN_PASSWORD=your_secure_admin_password_here
